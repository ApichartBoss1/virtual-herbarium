# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# ----- Supabase -----
# URL ของโปรเจกต์ Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# anon key สำหรับฝั่งเบราว์เซอร์ (เปิดเผยได้ ข้อมูลป้องกันด้วย RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- แผนที่ (ไม่บังคับ: เว้นว่างเพื่อใช้ค่าเริ่มต้นในโค้ด) -----
# tile ของแผนที่ ค่าเริ่มต้น https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
# ค้นหาพิกัดจากชื่อสถานที่ ค่าเริ่มต้น https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_FORWARD_GEOCODING_URL=
# ความสูงจากระดับน้ำทะเล ค่าเริ่มต้น https://api.open-meteo.com/v1/elevation
NEXT_PUBLIC_ELEVATION_URL=

# ----- AI (ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_ นำหน้า) -----
# API key ของ Anthropic ถ้าไม่ใส่ ฟีเจอร์ AI จะตอบ ai_not_configured
ANTHROPIC_API_KEY=
# รุ่นโมเดลที่ใช้ ค่าเริ่มต้น claude-haiku-5-5
AI_MODEL=claude-haiku-5-5

# ----- ทดสอบ (ใช้เฉพาะตอนทดสอบในเครื่อง) -----
# บัญชี admin สำหรับทดสอบหน้าใน /account และ API
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
# ไม่บังคับ: บัญชีที่ไม่ใช่ admin สำหรับทดสอบ 403 (สร้างชั่วคราวแล้วลบทิ้ง)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
